# Port of the local server. The redirect URI of your Spotify app must be http://127.0.0.1:<PORT>/start
PORT=777

# From your app in the Spotify Developer Dashboard (https://developer.spotify.com/dashboard)
CLIENT_ID=
CLIENT_SECRET=

# Queue routine (leave empty if you only want the shuffler)
# Playlist ID or spotify:playlist:... URI of the playlist you collect liked songs in
COLLECT_PLAYLIST_ID=
# Playlist ID or URI for songs without a clear main playlist
FALLBACK_PLAYLIST_ID=
